# Server
PORT=3001
NODE_ENV=development

# Authentication (change in production)
JWT_SECRET=change-this-to-a-long-random-string

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# iBluSend (primary messaging — iMessage/SMS via Mac bridge)
# Create keys at Developer → API Keys (use iblu_test_… for sandbox)
IBLUSEND_API_KEY=
IBLUSEND_WEBHOOK_SECRET=
IBLUSEND_DEVICE_ID=
IBLUSEND_BASE_URL=https://api.iblusend.com/functions/v1

# Messaging provider — which channel actually sends texts. 'twilio' or 'ibluesend'.
# Falls back to demo/console logging if the selected provider isn't configured below.
MESSAGING_PROVIDER=twilio

# iBluSend (client's real in-house texting channel)
IBLUESEND_API_KEY=
IBLUESEND_API_BASE=

# Zoho CRM
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_WEBHOOK_SECRET=

# Escalation email alerts — sent when a conversation is auto-escalated.
# Falls back to console logging if any of these are missing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ESCALATION_NOTIFY_EMAIL=

# Demo mode — set to false when real API keys are configured
DEMO_MODE=true

# Escalation alerts
ESCALATION_EMAIL=tech@nationwideadvance.com
DASHBOARD_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

